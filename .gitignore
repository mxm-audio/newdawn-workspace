# The workspace tracks only its own files. Every folder below is a repository of its own, private,
# or machine-local.
/newdawn/
/kit/*/
/player/*/
/instruments/*/
/effects/*/
/tools/*/
/ops/
/research/
/archive/
/projects/
/rust/
/wsl/archlinux/
/wsl/ubuntu-24.04/
target/
/target-shared/
/.cargo/

# Machine-local by-products: Python's bytecode cache (ws.py), and the crash dumps Git Bash tools write.
__pycache__/
*.stackdump
