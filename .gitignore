# The workspace tracks only its own files. Every folder below is a repository of its own, private,
# or machine-local.
/newdawn/
/kit/*/
/libs/*/
/format/*/
/player/*/
/instruments/*/
/effects/*/
/tools/*/
/apps/*/
/ops/
/research/
/archive/
/projects/
/rust/
/wsl/archlinux/
/wsl/ubuntu-24.04/
target/
/target-shared/
/.cargo/

# Machine-local by-products: Python's bytecode cache (ws.py), and the crash dumps Git Bash tools write.
__pycache__/
*.stackdump

# The Windows test VM's ISO and its state (disk, firmware variables, TPM): machine-local. Its
# scripts are tracked.
/vm/windows/*.iso
/vm/windows/state/
